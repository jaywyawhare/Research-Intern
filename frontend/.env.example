# Server-side only: where Next rewrites /v1/* (Docker/Render single container: http://127.0.0.1:8000).
# Do not set NEXT_PUBLIC_* to this URL — the browser cannot reach 127.0.0.1 inside your container.
# RESEARCH_API_URL=http://127.0.0.1:8000

# Comma-separated hostnames for Next allowedDevOrigins (e.g. LAN IP when using "Network" URL in dev)
# NEXT_DEV_EXTRA_ORIGIN_HOSTS=192.168.31.215

# If backend has RESEARCH_API_KEY set:
# NEXT_PUBLIC_RESEARCH_API_KEY=
