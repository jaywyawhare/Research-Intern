HYDRADB_API_KEY=
HYDRADB_TENANT_ID=
# Optional: per-user partition (B2C) or team id (B2B)
HYDRADB_SUB_TENANT_ID=
HYDRADB_HTTP_TIMEOUT=
# Pass graph_context=true on full_recall / recall_preferences (default: on). Set to 0 to disable.
HYDRADB_RECALL_GRAPH_CONTEXT=

# Polite Crossref User-Agent (optional)
RESEARCH_INTERN_CROSSREF_MAILTO=

# NCBI E-utilities (PubMed): optional tool name + email (see https://www.ncbi.nlm.nih.gov/books/NBK25497/)
RESEARCH_INTERN_NCBI_TOOL=
RESEARCH_INTERN_NCBI_EMAIL=

# Optional: higher Semantic Scholar rate limits (https://www.semanticscholar.org/product/api)
SEMANTIC_SCHOLAR_API_KEY=

# OpenAI-compatible API for CLI synthesis (default: run model; use --prompt-only to skip)
OPENAI_API_KEY=
# Or NVIDIA NIM (https://integrate.api.nvidia.com/v1) — same Bearer auth
NVIDIA_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEMPERATURE=0.3
OPENAI_TOP_P=
OPENAI_MAX_TOKENS=
# Long runs (Nemotron, large max_tokens)
OPENAI_TIMEOUT=600
# Example 30 RPM tier: minimum spacing between request starts
OPENAI_MAX_RPM=30
# JSON merged into POST /chat/completions (NVIDIA Nemotron "thinking" example):
# OPENAI_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":true},"reasoning_budget":16384}
OPENAI_EXTRA_BODY=
# Stream SSE to stderr while building the final answer (or use CLI --llm-stream)
OPENAI_STREAM=

# FastAPI backend (uvicorn)
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# Comma-separated origins, or * for any
FRONTEND_ORIGINS=*
# Optional: require X-API-Key or Authorization: Bearer <token>
RESEARCH_API_KEY=
# Session persistence: if MONGODB_URI is set, sessions are stored in MongoDB (SESSION_STORE is ignored).
# Without MONGODB_URI, the API uses in-memory sessions (lost on restart). SESSION_STORE=memory forces RAM when URI is unset.
SESSION_STORE=
MONGODB_URI=
MONGODB_DB=ai_researcher
MONGODB_COLLECTION=research_sessions
# If Atlas fails TLS (e.g. SSL handshake / TLSV1_ALERT_INTERNAL_ERROR), certifi CAs are used automatically.
# Tight firewalls only: MONGODB_TLS_DISABLE_OCSP=true
# Optional: MONGODB_SERVER_SELECTION_TIMEOUT_MS=45000
